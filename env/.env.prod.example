# Production environment for docker-compose. Copy to `env/.env` on the droplet and
# fill in real values. The real `env/.env` is git-ignored — never commit it.

# --- Django ---
SECRET_KEY=GENERATE_ME            # python -c "import secrets;print(secrets.token_urlsafe(64))"
DEBUG=False
# Domain(s) to serve + accept.
#   STAGING:    SITE_ADDRESS=staging.cosound.ca          PROD_HOSTS=staging.cosound.ca
#   PRODUCTION: SITE_ADDRESS=cosound.ca, www.cosound.ca  PROD_HOSTS=cosound.ca,www.cosound.ca
# (SITE_ADDRESS feeds Caddy; PROD_HOSTS feeds Django ALLOWED_HOSTS/CSRF — no spaces in PROD_HOSTS.)
SITE_ADDRESS=cosound.ca, www.cosound.ca
PROD_HOSTS=cosound.ca,www.cosound.ca
WEB_CONCURRENCY=1                 # 1 gunicorn worker for the 1 GB droplet
VOTE_THROTTLE_SECONDS=60
SERVER_REFRESH_INTERVAL=30

# --- Postgres (db reads POSTGRES_*, Django reads DATABASE_URL; keep the password in sync) ---
POSTGRES_USER=cosound
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=cosound
DATABASE_URL=postgres://cosound:CHANGE_ME_STRONG@db:5432/cosound   # host "db" = the compose service

# --- AWS (S3 media + SES email) ---
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_STORAGE_BUCKET_NAME=cosounds-frishkopf
AWS_S3_REGION_NAME=us-east-2

# --- First admin (optional bootstrap) ---
FIRST_ADMIN_EMAIL=admin@cosound.ca
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME_STRONG
